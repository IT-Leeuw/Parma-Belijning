---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://parma-belijning.nl/og-default.jpg',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness"],
  "name": "Parma Belijning Nederland",
  "legalName": "Belijning-Nederland B.V.",
  "url": "https://parma-belijning.nl/",
  "logo": "https://parma-belijning.nl/logo.svg",
  "image": ogImage,
  "telephone": "+31235650840",
  "email": "info@parma-belijning.nl",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "IJweg 616",
    "postalCode": "2141 CN",
    "addressLocality": "Vijfhuizen",
    "addressRegion": "Noord-Holland",
    "addressCountry": "NL"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 52.3434,
    "longitude": 4.6926
  },
  "areaServed": {
    "@type": "Country",
    "name": "Nederland"
  },
  "description": "Parma Belijning Nederland verzorgt professionele vloermarkeringen voor magazijnen, industriële omgevingen, parkeerterreinen en sportvelden door heel Nederland.",
  "slogan": "Hét adres voor alle denkbare soorten belijning",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "17:00"
    }
  ]
};

const allSchemas = [orgSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Parma Belijning Nederland" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Structured Data -->
    {allSchemas.map(s => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="font-sans text-slate-800 antialiased">
    <slot />
  </body>
</html>
