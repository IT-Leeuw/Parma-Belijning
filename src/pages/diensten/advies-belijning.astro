---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Advies belijning en markering",
  "provider": { "@type": "LocalBusiness", "name": "Parma Belijning Nederland" },
  "areaServed": { "@type": "Country", "name": "Nederland" },
  "description": "Parma Belijning Nederland biedt kosteloos advies over de beste belijningsstrategie voor uw situatie — van materiaalkeuze tot lay-outplanning.",
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://parma-belijning.nl/" },
    { "@type": "ListItem", "position": 2, "name": "Diensten", "item": "https://parma-belijning.nl/diensten/" },
    { "@type": "ListItem", "position": 3, "name": "Advies belijning", "item": "https://parma-belijning.nl/diensten/advies-belijning/" }
  ]
};
---

<Layout
  title="Advies Belijning & Markering | Parma Belijning Nederland"
  description="Parma Belijning Nederland adviseert u kosteloos over de beste belijningsstrategie voor uw situatie. Van materiaalkeuze tot volledige lay-outplanning."
  schema={[schema, breadcrumb]}
>
  <Header />
  <main>

    <nav class="bg-slate-50 border-b border-slate-200" aria-label="Kruimelpad">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><span class="text-slate-400">Diensten</span></li>
          <li><span class="text-slate-300">/</span></li>
          <li class="font-medium text-slate-700">Advies belijning / Markering</li>
        </ol>
      </div>
    </nav>

    <section class="bg-slate-900 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-brand-400 text-xs font-bold uppercase tracking-widest mb-4">Onze diensten</p>
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
            Advies belijning<br><span class="text-brand-400">& markering</span>
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed mb-8">
            Parma Belijning Nederland denkt graag met u mee. Of het nu gaat om de materiaalkeuze, de indeling van uw ruimte of de vraag of u moet kogelstralen — onze adviseurs geven u concreet, deskundig advies.
          </p>
          <a href="/contact/" class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-400 text-white font-bold px-6 py-3.5 rounded-xl transition-colors shadow-md">
            Vraag advies aan
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <h2 class="text-2xl font-black text-slate-900 mb-4">Een competente partner die meedenkt</h2>
            <p class="text-slate-600 leading-relaxed mb-6">
              Met Parma Belijning Nederland heeft u een partner die over alle aspecten van grondmarkeringen en belijning adviseert. Wij beoordelen uw situatie ter plaatse en stellen een optimale indeling voor — afgestemd op uw werkprocessen, veiligheidseisen en budget.
            </p>
            <p class="text-slate-600 leading-relaxed mb-6">
              Van innovatieve ideeën tot vakkundige uitvoering: wij begeleiden u van de eerste schets tot de definitieve markering.
            </p>
            <h3 class="text-xl font-bold text-slate-900 mb-4 mt-6">Waarover adviseren wij?</h3>
            <ul class="space-y-3">
              {[
                'Materiaalkeuze (verf, thermoplast, koudplast, PMMA, tape)',
                'Kleurcodering conform normen (Arbo, NEN)',
                'Lay-out van looproutes en rijbanen',
                'Voorbereiding van de ondergrond (kogelstralen)',
                'Combinatie van coating en belijning',
                'Planning en uitvoering met minimale bedrijfsstilstand',
                '5S en lean methodieken',
              ].map(item => (
                <li class="flex items-start gap-3 text-slate-700">
                  <svg class="w-5 h-5 text-brand-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-slate-900 rounded-2xl p-8 text-white">
            <h3 class="font-bold text-xl mb-4">Neem contact op voor advies</h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-6">
              Bel ons of stuur een e-mail — wij nemen altijd snel contact op voor een eerste adviesgesprek.
            </p>
            <div class="space-y-4">
              <a href="tel:0235650840" class="flex items-center gap-3 bg-white/10 hover:bg-white/20 rounded-xl px-5 py-4 transition-colors">
                <svg class="w-5 h-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" /></svg>
                <div>
                  <p class="text-xs text-slate-400">Bel ons</p>
                  <p class="font-bold">023 565 08 40</p>
                </div>
              </a>
              <a href="mailto:info@parma-belijning.nl" class="flex items-center gap-3 bg-white/10 hover:bg-white/20 rounded-xl px-5 py-4 transition-colors">
                <svg class="w-5 h-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                <div>
                  <p class="text-xs text-slate-400">Mail ons</p>
                  <p class="font-bold">info@parma-belijning.nl</p>
                </div>
              </a>
              <a href="/offerte/" class="flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-white font-bold px-5 py-4 rounded-xl transition-colors">
                Offerte aanvragen
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
