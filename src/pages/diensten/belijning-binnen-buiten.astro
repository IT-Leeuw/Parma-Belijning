---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Belijning binnen en buiten",
  "provider": { "@type": "LocalBusiness", "name": "Parma Belijning Nederland" },
  "areaServed": { "@type": "Country", "name": "Nederland" },
  "description": "Parma Belijning Nederland verzorgt professionele belijning zowel binnen als buiten. Van magazijnen en bedrijfshallen tot parkeerterreinen en sportvelden.",
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://parma-belijning.nl/" },
    { "@type": "ListItem", "position": 2, "name": "Diensten", "item": "https://parma-belijning.nl/diensten/" },
    { "@type": "ListItem", "position": 3, "name": "Belijning binnen / buiten", "item": "https://parma-belijning.nl/diensten/belijning-binnen-buiten/" }
  ]
};
---

<Layout
  title="Belijning Binnen & Buiten | Parma Belijning Nederland"
  description="Parma Belijning Nederland verzorgt professionele belijning zowel binnen als buiten. Magazijnen, parkeerterreinen, sportvelden en meer — door heel Nederland."
  schema={[schema, breadcrumb]}
>
  <Header />
  <main>

    <nav class="bg-slate-50 border-b border-slate-200" aria-label="Kruimelpad">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><span class="text-slate-400">Diensten</span></li>
          <li><span class="text-slate-300">/</span></li>
          <li class="font-medium text-slate-700">Belijning binnen / buiten</li>
        </ol>
      </div>
    </nav>

    <section class="bg-slate-900 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-brand-400 text-xs font-bold uppercase tracking-widest mb-4">Onze diensten</p>
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
            Belijning<br><span class="text-brand-400">binnen & buiten</span>
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed mb-8">
            Parma Belijning Nederland verzorgt professionele markeringen op alle soorten ondergronden — zowel binnen als buiten. Van betonnen bedrijfsvloeren tot asfalt parkeerterreinen en buitensportterreinen.
          </p>
          <a href="/offerte/?dienst=belijning-binnen-buiten" class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-400 text-white font-bold px-6 py-3.5 rounded-xl transition-colors shadow-md">
            Offerte aanvragen
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
            <div class="w-12 h-12 bg-slate-900 rounded-xl flex items-center justify-center text-white mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-3">Binnenbelijning</h2>
            <p class="text-slate-600 text-sm leading-relaxed mb-4">Geschikt voor magazijnen, productiehal, parkeergarages en sportcomplexen. De ondergrond is beschermd tegen regen en zon, waardoor dunne materialen mogelijk zijn.</p>
            <ul class="space-y-2 text-sm text-slate-700">
              {['Betonvloeren', 'Epoxyvloeren', 'Tegelvloeren', 'Asfalt (rijbanen binnen)'].map(t => (
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></span>{t}</li>
              ))}
            </ul>
          </div>
          <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
            <div class="w-12 h-12 bg-brand-500 rounded-xl flex items-center justify-center text-white mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-3">Buitenbelijning</h2>
            <p class="text-slate-600 text-sm leading-relaxed mb-4">Bestand tegen weersinvloeden, UV-straling en rijdend verkeer. We gebruiken weersbestendige materialen met lange levensduur.</p>
            <ul class="space-y-2 text-sm text-slate-700">
              {['Asfaltverharding', 'Betonverharding', 'Klinkers / tegels', 'Sportvelden (kunstgras, rubber)'].map(t => (
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></span>{t}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-12 bg-brand-50 border border-brand-200 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-slate-900 mb-3">Materiaaladvies voor elke ondergrond</h3>
          <p class="text-slate-600 leading-relaxed">
            Het juiste markeringsmateriaal hangt af van de ondergrond, de belasting (voetgangers, heftrucks, voertuigen), en of het buiten of binnen betreft. Parma Belijning Nederland adviseert u kosteloos over de beste keuze.
          </p>
          <a href="/offerte/?dienst=belijning-binnen-buiten" class="inline-flex items-center gap-2 mt-5 bg-brand-500 hover:bg-brand-600 text-white font-semibold px-5 py-3 rounded-xl transition-colors text-sm">
            Vraag vrijblijvend advies aan
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
