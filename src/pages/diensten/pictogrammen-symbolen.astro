---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Pictogrammen en symbolen",
  "provider": { "@type": "LocalBusiness", "name": "Parma Belijning Nederland" },
  "areaServed": { "@type": "Country", "name": "Nederland" },
  "description": "Parma Belijning Nederland brengt pictogrammen en symbolen aan op vloeren — gehandicaptensymbolen, pijlen, waarschuwingen en meer conform NEN/ISO-normen.",
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://parma-belijning.nl/" },
    { "@type": "ListItem", "position": 2, "name": "Diensten", "item": "https://parma-belijning.nl/diensten/" },
    { "@type": "ListItem", "position": 3, "name": "Pictogrammen / Symbolen", "item": "https://parma-belijning.nl/diensten/pictogrammen-symbolen/" }
  ]
};
---

<Layout
  title="Pictogrammen & Symbolen | Parma Belijning Nederland"
  description="Professionele vloerpictogrammen en symbolen door Parma Belijning Nederland. Gehandicaptensymbolen, pijlen, waarschuwingen — conform NEN/ISO-normen."
  schema={[schema, breadcrumb]}
>
  <Header />
  <main>

    <nav class="bg-slate-50 border-b border-slate-200" aria-label="Kruimelpad">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><span class="text-slate-400">Diensten</span></li>
          <li><span class="text-slate-300">/</span></li>
          <li class="font-medium text-slate-700">Pictogrammen / Symbolen</li>
        </ol>
      </div>
    </nav>

    <section class="bg-slate-900 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-brand-400 text-xs font-bold uppercase tracking-widest mb-4">Onze diensten</p>
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
            Pictogrammen<br><span class="text-brand-400">& Symbolen</span>
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed mb-8">
            Pictogrammen en symbolen op de vloer versterken de veiligheid en overzichtelijkheid van uw bedrijfsruimte. Parma Belijning Nederland brengt alle gangbare symbolen aan — snel, nauwkeurig en conform de geldende normen.
          </p>
          <a href="/offerte/?dienst=pictogrammen-symbolen" class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-400 text-white font-bold px-6 py-3.5 rounded-xl transition-colors shadow-md">
            Offerte aanvragen
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-3 gap-6 mb-16">
          {[
            { title: 'Verkeerspictogrammen', items: ['Rijrichtingspijlen', 'Stoplijnen', 'Voorrangsmarkering', 'Snelheidslimieten'] },
            { title: 'Veiligheidssymbolen', items: ['Gehandicaptensymbool (ISA)', 'Voetgangerszone', 'Vluchtroute-pijlen', 'Gevaar / waarschuwing'] },
            { title: 'Bedrijfssymbolen', items: ['Laad- en loszone', 'Opslagzone markering', 'Nooduitgang', 'Brandweeringang'] },
          ].map(cat => (
            <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
              <h3 class="font-bold text-slate-900 mb-4">{cat.title}</h3>
              <ul class="space-y-2">
                {cat.items.map(item => (
                  <li class="flex items-center gap-2 text-sm text-slate-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="bg-brand-50 border border-brand-200 rounded-2xl p-8">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <h2 class="text-2xl font-black text-slate-900 mb-3">Aangebracht via sjablonen</h2>
              <p class="text-slate-600 leading-relaxed">
                Alle pictogrammen worden aangebracht met behulp van professionele sjablonen voor een strak, nauwkeurig en herhaalbaar resultaat. De symbolen voldoen aan de gangbare NEN/ISO-normen en zijn beschikbaar in alle gangbare maten.
              </p>
            </div>
            <div class="flex justify-center md:justify-end">
              <a href="/offerte/?dienst=pictogrammen-symbolen" class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-bold px-6 py-3.5 rounded-xl transition-colors">
                Vrijblijvend advies aanvragen
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
