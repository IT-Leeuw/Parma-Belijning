---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const dienst = Astro.url.searchParams.get('dienst') ?? '';

const dienstLabels: Record<string, string> = {
  'magazijn-logistieke-belijning': 'Magazijn / Logistieke belijning',
  'industriele-belijning': 'Industriële belijning',
  'parkeer-belijning': 'Parkeer belijning',
  'belijning-binnen-buiten': 'Belijning binnen / buiten',
  'kogelstralen': 'Kogelstralen',
  'vloercoating': 'Vloercoating',
  'pictogrammen-symbolen': 'Pictogrammen / Symbolen',
  'advies-belijning': 'Advies belijning / Markering',
};

const dienstLabel = dienstLabels[dienst] ?? '';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Offerte aanvragen — Parma Belijning Nederland",
  "url": "https://parma-belijning.nl/offerte/",
  "description": "Vraag vrijblijvend een offerte aan bij Parma Belijning Nederland voor professionele vloermarkering en belijning.",
};
---

<Layout
  title="Offerte Aanvragen | Parma Belijning Nederland"
  description="Vraag vrijblijvend een offerte aan bij Parma Belijning Nederland. Vul het formulier in en we nemen snel contact met u op voor een prijsopgave op maat."
  schema={schema}
  noindex={false}
>
  <Header />
  <main>

    <nav class="bg-slate-50 border-b border-slate-200" aria-label="Kruimelpad">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li class="font-medium text-slate-700">Offerte aanvragen</li>
        </ol>
      </div>
    </nav>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-start">

          <!-- Info -->
          <div>
            <p class="text-brand-600 text-xs font-bold uppercase tracking-widest mb-3">Vrijblijvend</p>
            <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-6">
              Offerte aanvragen
            </h1>
            <p class="text-lg text-slate-600 leading-relaxed mb-8">
              Vul het formulier in en wij nemen zo snel mogelijk contact met u op. Heeft u liever direct contact? Bel ons op <a href="tel:0235650840" class="font-semibold text-brand-600 hover:text-brand-700">023 565 08 40</a>.
            </p>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-brand-100 rounded-xl flex items-center justify-center text-brand-600 shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900">Vrijblijvende offerte</h3>
                  <p class="text-sm text-slate-500">U bent nergens aan verbonden. We sturen u een heldere prijsopgave.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-brand-100 rounded-xl flex items-center justify-center text-brand-600 shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900">Snelle reactie</h3>
                  <p class="text-sm text-slate-500">We streven ernaar binnen 1 werkdag contact met u op te nemen.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-brand-100 rounded-xl flex items-center justify-center text-brand-600 shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900">Heel Nederland</h3>
                  <p class="text-sm text-slate-500">Parma Belijning Nederland werkt door heel Nederland.</p>
                </div>
              </div>
            </div>

            <div class="mt-10 p-6 bg-slate-50 rounded-2xl border border-slate-200">
              <p class="font-semibold text-slate-900 mb-1">Direct bellen?</p>
              <a href="tel:0235650840" class="text-2xl font-black text-brand-600 hover:text-brand-700 transition-colors">023 565 08 40</a>
              <p class="text-xs text-slate-400 mt-1">Maandag t/m vrijdag 08:00–17:00</p>
            </div>
          </div>

          <!-- Form -->
          <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
            <h2 class="text-xl font-bold text-slate-900 mb-6">Uw gegevens</h2>
            <form
              method="POST"
              action="/offerte/bedankt/"
              name="offerte"
              class="space-y-5"
            >
              <!-- Honeypot -->
              <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

              <div>
                <label for="naam" class="block text-sm font-medium text-slate-700 mb-1.5">Naam <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  id="naam"
                  name="naam"
                  required
                  autocomplete="name"
                  class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
                  placeholder="Uw volledige naam"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">E-mailadres <span class="text-red-500">*</span></label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
                  placeholder="naam@bedrijf.nl"
                />
              </div>

              <div>
                <label for="telefoon" class="block text-sm font-medium text-slate-700 mb-1.5">Telefoonnummer <span class="text-red-500">*</span></label>
                <input
                  type="tel"
                  id="telefoon"
                  name="telefoon"
                  required
                  autocomplete="tel"
                  class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
                  placeholder="06 12 34 56 78"
                />
              </div>

              <div>
                <label for="omschrijving" class="block text-sm font-medium text-slate-700 mb-1.5">Omschrijving van uw aanvraag <span class="text-red-500">*</span></label>
                <textarea
                  id="omschrijving"
                  name="omschrijving"
                  required
                  rows="5"
                  class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition resize-none"
                  placeholder="Beschrijf uw situatie: wat voor belijning heeft u nodig, hoeveel m², op welke locatie, en heeft u specifieke wensen?"
                ></textarea>
              </div>

              {dienstLabel && (
                <input type="hidden" name="dienst" value={dienstLabel} />
              )}

              <button
                type="submit"
                class="w-full flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-md shadow-brand-500/20"
              >
                Offerte aanvragen
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </button>
              <p class="text-xs text-slate-400 text-center">Geen cookiewall, geen verborgen kosten. U bent nergens aan verbonden.</p>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
