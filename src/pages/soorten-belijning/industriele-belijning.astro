---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Industriële belijning",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Parma Belijning Nederland",
    "telephone": "+31235650840",
    "email": "info@parma-belijning.nl"
  },
  "areaServed": { "@type": "Country", "name": "Nederland" },
  "description": "Parma Belijning Nederland verzorgt industriële belijning voor productieomgevingen, inclusief 5S-zones, opstelvakken en procesondersteunende markering.",
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://parma-belijning.nl/" },
    { "@type": "ListItem", "position": 2, "name": "Soorten belijning", "item": "https://parma-belijning.nl/soorten-belijning/" },
    { "@type": "ListItem", "position": 3, "name": "Industriële belijning", "item": "https://parma-belijning.nl/soorten-belijning/industriele-belijning/" }
  ]
};
---

<Layout
  title="Industriële Belijning | Parma Belijning Nederland"
  description="Professionele industriële belijning voor productieomgevingen en bedrijfshallen. 5S-zones, opstelvakken, vluchtroutes. Conform Bouwbesluit & Arbo. Offerte aanvragen."
  schema={[schema, breadcrumb]}
>
  <Header />
  <main>

    <nav class="bg-slate-50 border-b border-slate-200" aria-label="Kruimelpad">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><span class="text-slate-400">Soorten belijning</span></li>
          <li><span class="text-slate-300">/</span></li>
          <li class="font-medium text-slate-700">Industriële belijning</li>
        </ol>
      </div>
    </nav>

    <section class="bg-slate-900 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-brand-400 text-xs font-bold uppercase tracking-widest mb-4">Soorten belijning</p>
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
            Industriële<br><span class="text-brand-400">belijning</span>
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed mb-8">
            Naast de wettelijke veiligheidseisen zijn er tal van goede redenen om belijning in industriële en productieomgevingen aan te brengen. Parma Belijning Nederland brengt duidelijke, duurzame markeringen aan die uw processen ondersteunen.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/offerte/?dienst=industriele-belijning" class="inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-white font-bold px-6 py-3.5 rounded-xl transition-colors shadow-md">
              Offerte aanvragen
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
            <a href="tel:0235650840" class="inline-flex items-center justify-center gap-2 border border-slate-600 hover:border-slate-400 text-slate-200 hover:text-white font-semibold px-6 py-3.5 rounded-xl transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" /></svg>
              023 565 08 40
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <h2 class="text-2xl font-black text-slate-900 mb-4">Procesondersteunende belijning</h2>
            <p class="text-slate-600 leading-relaxed mb-6">
              Steeds meer bedrijven maken gebruik van procesondersteunende belijning. Met of zonder 5S-methodiek kan het nuttig zijn om de functie van gebieden en opstelplaatsen letterlijk te benoemen en te markeren.
            </p>
            <p class="text-slate-600 leading-relaxed mb-6">
              Duidelijk gemarkeerde opstelvakken en looproutes in uw bedrijfshal dragen bij aan efficiënt gebruik van beschikbare ruimtes, veiligheid en overzicht. Parma Belijning Nederland adviseert u over de beste aanpak voor uw specifieke productieomgeving.
            </p>
            <h3 class="text-xl font-bold text-slate-900 mb-4 mt-8">Toepassingen in de industrie</h3>
            <ul class="space-y-3">
              {[
                'Opstelvakken voor machines en pallets',
                '5S-zones en werkplekorganisatie',
                'Looproutes gescheiden van voertuigverkeer',
                'Vluchtroutes en nooduitgangen',
                'Gevaarzones en verbodszones',
                'Productie- en controlezones',
                'Tijdelijke belijning tijdens verbouwingen',
              ].map(item => (
                <li class="flex items-start gap-3 text-slate-700">
                  <svg class="w-5 h-5 text-brand-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="space-y-6">
            <div class="bg-slate-900 rounded-2xl p-8 text-white">
              <h3 class="font-bold text-xl mb-2">Wettelijke vereisten</h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-4">
                Industriële belijning valt onder de veiligheidseisen van het Bouwbesluit en de Arbo-wet. Parma Belijning Nederland zorgt ervoor dat uw markeringen altijd compliant zijn.
              </p>
              <div class="flex items-center gap-3 text-brand-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                <span class="font-semibold">Conform Bouwbesluit & Arbo-wet</span>
              </div>
            </div>

            <div class="bg-brand-50 border border-brand-200 rounded-2xl p-8">
              <h3 class="font-bold text-slate-900 text-lg mb-4">Voordelen van industriële belijning</h3>
              <ul class="space-y-3">
                {[
                  'Verhoogde veiligheid voor medewerkers',
                  'Efficiënter gebruik van vloeroppervlak',
                  'Ondersteuning van lean en 5S-methodieken',
                  'Duidelijk overzicht en betere orde',
                  'Voldoet aan wet- en regelgeving',
                ].map(v => (
                  <li class="flex items-center gap-2 text-sm text-slate-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></span>
                    {v}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-brand-500">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl md:text-3xl font-black text-white mb-4">Industriële belijning laten aanbrengen?</h2>
        <p class="text-brand-100 mb-8">Parma Belijning Nederland maakt een indeling op maat voor uw productieomgeving.</p>
        <a href="/offerte/?dienst=industriele-belijning" class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-brand-600 font-bold px-7 py-4 rounded-xl shadow-lg transition-colors">
          Vraag een offerte aan
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
