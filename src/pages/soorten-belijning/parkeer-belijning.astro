---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Parkeer belijning en belijning parking",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Parma Belijning Nederland",
    "telephone": "+31235650840",
    "email": "info@parma-belijning.nl"
  },
  "areaServed": { "@type": "Country", "name": "Nederland" },
  "description": "Parma Belijning Nederland verzorgt parkeer belijning voor parkeerterreinen en parkeergarages door heel Nederland. Inclusief gehandicaptenparkeerplaatsen en pictogrammen.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wat zijn de standaard afmetingen van een parkeervak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Een standaard parkeervak is 5,0 meter lang en 2,5 meter breed. Een gehandicaptenparkeerplaats is minimaal 5,0 meter lang en 3,5 meter breed."
      }
    },
    {
      "@type": "Question",
      "name": "Welk materiaal wordt gebruikt voor parkeer belijning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Afhankelijk van de ondergrond en de te verwachten belasting adviseert Parma Belijning Nederland het juiste markeringsmateriaal. Voor parkeerterreinen buiten wordt vaak thermoplast of 2K-wegenverf gebruikt vanwege de slijtvastheid."
      }
    }
  ]
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://parma-belijning.nl/" },
    { "@type": "ListItem", "position": 2, "name": "Soorten belijning", "item": "https://parma-belijning.nl/soorten-belijning/" },
    { "@type": "ListItem", "position": 3, "name": "Parkeer belijning", "item": "https://parma-belijning.nl/soorten-belijning/parkeer-belijning/" }
  ]
};
---

<Layout
  title="Parkeer Belijning | Parma Belijning Nederland"
  description="Professionele parkeer belijning voor parkeerterreinen en parkeergarages door heel Nederland. Standaard en gehandicaptenparkeerplaatsen, pictogrammen en meer."
  schema={[schema, faqSchema, breadcrumb]}
>
  <Header />
  <main>

    <nav class="bg-slate-50 border-b border-slate-200" aria-label="Kruimelpad">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><span class="text-slate-400">Soorten belijning</span></li>
          <li><span class="text-slate-300">/</span></li>
          <li class="font-medium text-slate-700">Parkeer belijning</li>
        </ol>
      </div>
    </nav>

    <section class="bg-slate-900 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-brand-400 text-xs font-bold uppercase tracking-widest mb-4">Soorten belijning</p>
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
            Parkeer belijning<br><span class="text-brand-400">& parking markering</span>
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed mb-8">
            Belijning en markering op parkeerterreinen en in parkeergarages zorgt voor efficiënt gebruik van uw beschikbare ruimte en een ordentelijk parkeerproces. Parma Belijning Nederland adviseert het juiste materiaal voor elke ondergrond.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/offerte/?dienst=parkeer-belijning" class="inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-white font-bold px-6 py-3.5 rounded-xl transition-colors shadow-md">
              Offerte aanvragen
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
            <a href="tel:0235650840" class="inline-flex items-center justify-center gap-2 border border-slate-600 hover:border-slate-400 text-slate-200 hover:text-white font-semibold px-6 py-3.5 rounded-xl transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" /></svg>
              023 565 08 40
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <h2 class="text-2xl font-black text-slate-900 mb-4">Efficiënte parkeermarkering op maat</h2>
            <p class="text-slate-600 leading-relaxed mb-6">
              Of het nu gaat om een bedrijfsparkeerterrein, een openbaar parkeerterrein of een parkeergarage — Parma Belijning Nederland zorgt voor een duidelijke, duurzame markering. Afhankelijk van de ondergrond en de te verwachten belasting adviseren wij het juiste markeringsmateriaal.
            </p>
            <h3 class="text-xl font-bold text-slate-900 mb-4 mt-6">Wat wij markeren</h3>
            <ul class="space-y-3 mb-8">
              {[
                'Standaard parkeervakken (5,0 m × 2,5 m)',
                'Gehandicaptenparkeerplaatsen (min. 5,0 m × 3,5 m)',
                'Vrachtwagen- en bestelwagenparkeerplaatsen',
                'Rijrichtingspijlen en verkeersmarkering',
                'Nummering van parkeerplaatsen',
                'Pictogrammen en symbolen',
                'Laad- en loszones',
                'Motorparkeerplaatsen',
              ].map(item => (
                <li class="flex items-start gap-3 text-slate-700">
                  <svg class="w-5 h-5 text-brand-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="space-y-6">
            <div class="bg-brand-50 border border-brand-200 rounded-2xl p-8">
              <h3 class="font-bold text-slate-900 text-lg mb-4">Standaard parkeervak afmetingen</h3>
              <div class="space-y-4">
                <div class="bg-white rounded-xl p-4 border border-brand-100">
                  <p class="font-bold text-slate-800 mb-1">Standaard parkeervak</p>
                  <p class="text-2xl font-black text-brand-600">5,0 m × 2,5 m</p>
                </div>
                <div class="bg-white rounded-xl p-4 border border-brand-100">
                  <p class="font-bold text-slate-800 mb-1">Gehandicaptenparkeerplaats</p>
                  <p class="text-2xl font-black text-brand-600">min. 5,0 m × 3,5 m</p>
                </div>
              </div>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8">
              <h3 class="font-bold text-slate-900 text-lg mb-3">Geschikt voor</h3>
              <ul class="space-y-2 text-sm text-slate-700">
                {[
                  'Bedrijfsparkeerterreinen',
                  'Openbare parkeerterreinen',
                  'Parkeergarages (binnen)',
                  'Winkelcentra',
                  'Ziekenhuizen en zorginstellingen',
                  'Overheidsgebouwen',
                ].map(t => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></span>
                    {t}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-black text-slate-900 mb-8 text-center">Veelgestelde vragen over parkeer belijning</h2>
        <div class="space-y-3">
          {[
            { q: 'Wat zijn de standaard afmetingen van een parkeervak?', a: 'Een standaard parkeervak is 5,0 meter lang en 2,5 meter breed. Een gehandicaptenparkeerplaats is minimaal 5,0 meter lang en 3,5 meter breed.' },
            { q: 'Welk materiaal wordt gebruikt voor parkeer belijning?', a: 'Afhankelijk van de ondergrond en verwachte belasting. Buiten wordt vaak thermoplast of 2K-wegenverf gebruikt vanwege slijtvastheid. Binnen (parkeergarage) kan koudplast of PMMA geschikter zijn.' },
            { q: 'Kunnen jullie ook rijrichtingen en pijlen markeren?', a: 'Ja, Parma Belijning Nederland markeert ook rijrichtingspijlen, stoplijnen, verkeersborden op de vloer en alle andere verkeersmarkeringen die nodig zijn voor een veilig en overzichtelijk parkeerterrein.' },
          ].map(faq => (
            <details class="group bg-white border border-slate-200 rounded-2xl overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none font-semibold text-slate-900 hover:bg-slate-50 transition-colors">
                {faq.q}
                <svg class="w-5 h-5 text-slate-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="px-6 pb-5 text-slate-600 text-sm leading-relaxed border-t border-slate-100 pt-4">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-brand-500">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl md:text-3xl font-black text-white mb-4">Parkeer belijning nodig?</h2>
        <p class="text-brand-100 mb-8">Neem contact op met Parma Belijning Nederland voor een vrijblijvende offerte op maat.</p>
        <a href="/offerte/?dienst=parkeer-belijning" class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-brand-600 font-bold px-7 py-4 rounded-xl shadow-lg transition-colors">
          Vraag een offerte aan
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
