---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Magazijn en logistieke belijning",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Parma Belijning Nederland",
    "telephone": "+31235650840",
    "email": "info@parma-belijning.nl"
  },
  "areaServed": { "@type": "Country", "name": "Nederland" },
  "description": "Parma Belijning Nederland verzorgt professionele magazijn- en logistieke belijning voor distributiecentra en warehouses door heel Nederland.",
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "areaServed": "Nederland"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Waarom is magazijnbelijning verplicht?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Veiligheidsmarkeringen in magazijnen en distributiecentra zijn verplicht op grond van het Bouwbesluit en de Arbo-wet. Duidelijke looproutes en rijbanen beschermen medewerkers en voldoen aan de wettelijke veiligheidseisen."
      }
    },
    {
      "@type": "Question",
      "name": "Welke kleuren worden gebruikt voor magazijnbelijning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Geel wordt standaard gebruikt voor rijbanen en voetgangerszones. Wit voor opslagvakken en rood voor verbodszones of nooduitgangen. Parma Belijning Nederland adviseert over de juiste kleurcodering voor uw situatie."
      }
    }
  ]
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://parma-belijning.nl/" },
    { "@type": "ListItem", "position": 2, "name": "Soorten belijning", "item": "https://parma-belijning.nl/soorten-belijning/" },
    { "@type": "ListItem", "position": 3, "name": "Magazijn / Logistieke belijning", "item": "https://parma-belijning.nl/soorten-belijning/magazijn-logistieke-belijning/" }
  ]
};
---

<Layout
  title="Magazijn & Logistieke Belijning | Parma Belijning Nederland"
  description="Professionele magazijn- en logistieke belijning door heel Nederland. Looproutes, rijbanen, veiligheidszones — conform Bouwbesluit en Arbo. Vraag een offerte aan."
  schema={[schema, faqSchema, breadcrumb]}
>
  <Header />
  <main>

    <!-- Breadcrumb -->
    <nav class="bg-slate-50 border-b border-slate-200" aria-label="Kruimelpad">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><span class="text-slate-400">Soorten belijning</span></li>
          <li><span class="text-slate-300">/</span></li>
          <li class="font-medium text-slate-700">Magazijn / Logistieke belijning</li>
        </ol>
      </div>
    </nav>

    <!-- Hero -->
    <section class="bg-slate-900 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-brand-400 text-xs font-bold uppercase tracking-widest mb-4">Soorten belijning</p>
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
            Magazijn & Logistieke<br><span class="text-brand-400">belijning</span>
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl">
            Veilige en overzichtelijke belijning voor uw distributiecentrum of magazijn. Parma Belijning Nederland markeert looppaden, rijbanen en opslagzones — conform het Bouwbesluit en de Arbo-wet.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/offerte/?dienst=magazijn-logistieke-belijning" class="inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-white font-bold px-6 py-3.5 rounded-xl transition-colors shadow-md">
              Offerte aanvragen
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
            <a href="tel:0235650840" class="inline-flex items-center justify-center gap-2 border border-slate-600 hover:border-slate-400 text-slate-200 hover:text-white font-semibold px-6 py-3.5 rounded-xl transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" /></svg>
              023 565 08 40
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Content -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <h2 class="text-2xl font-black text-slate-900 mb-4">Veilige looproutes duidelijk aangeven</h2>
            <p class="text-slate-600 leading-relaxed mb-6">
              In magazijnen en distributiecentra is het essentieel dat voetgangers en voertuigen gescheiden circuleren. Parma Belijning Nederland brengt duidelijke looppaden aan die aangeven waar medewerkers mogen lopen — gescheiden van heftrucken en andere logistieke voertuigen.
            </p>
            <p class="text-slate-600 leading-relaxed mb-6">
              Onze belijning voor de logistiek voldoet aan alle wettelijke veiligheidseisen zoals vastgelegd in het Bouwbesluit en de Arbo-wet. U bent daarmee altijd compliant en uw medewerkers werken veilig.
            </p>
            <h2 class="text-2xl font-black text-slate-900 mb-4 mt-10">Wat wij markeren in uw magazijn</h2>
            <ul class="space-y-3">
              {[
                'Looppaden en voetgangerszones (geel)',
                'Rijbanen voor heftrucks en voertuigen',
                'Opslagvakken en stellingzones',
                'Laad- en loszones',
                'Nooduitgangen en vluchtroutes',
                'Verbodszones en gevaarzones',
                'Pictogrammen en symbolen conform NEN/ISO-normen',
              ].map(item => (
                <li class="flex items-start gap-3 text-slate-700">
                  <span class="w-5 h-5 rounded-full bg-brand-500 flex items-center justify-center shrink-0 mt-0.5 text-white text-xs font-bold">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="space-y-6">
            <div class="bg-brand-50 border border-brand-200 rounded-2xl p-8">
              <h3 class="font-bold text-slate-900 text-lg mb-3">Gebruikte materialen</h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-4">Het juiste materiaal wordt afgestemd op uw ondergrond en de te verwachten belasting van heftrucks en andere voertuigen.</p>
              <ul class="space-y-2 text-sm text-slate-700">
                {[
                  '2-componenten wegenverf (duurzaam, sneldrogend)',
                  'Thermoplast (geschikt voor zwaar verkeer)',
                  'Koudplast / PMMA',
                  'Premark (voor bijzondere toepassingen)',
                  'Markeringstape (tijdelijk of permanent)',
                ].map(m => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></span>
                    {m}
                  </li>
                ))}
              </ul>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8">
              <h3 class="font-bold text-slate-900 text-lg mb-3">Snelle droogtijden</h3>
              <div class="space-y-3">
                {[
                  { mat: '2K-wegenverf', time: 'Na 1 uur beloopbaar, na 72 uur volledig uitgehard' },
                  { mat: 'Thermoplast', time: 'Na 10 minuten beloopbaar' },
                  { mat: 'Koudplast / PMMA', time: 'Na 15–20 minuten beloopbaar' },
                ].map(d => (
                  <div class="flex justify-between gap-4 text-sm border-b border-slate-200 pb-3 last:border-0 last:pb-0">
                    <span class="font-medium text-slate-800">{d.mat}</span>
                    <span class="text-slate-500 text-right">{d.time}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-black text-slate-900 mb-8 text-center">Veelgestelde vragen over magazijnbelijning</h2>
        <div class="space-y-3">
          {[
            { q: 'Waarom is magazijnbelijning verplicht?', a: 'Veiligheidsmarkeringen in magazijnen zijn verplicht op grond van het Bouwbesluit en de Arbo-wet. Duidelijke looproutes en rijbanen beschermen medewerkers en voldoen aan de wettelijke veiligheidseisen.' },
            { q: 'Welke kleuren worden gebruikt?', a: 'Geel voor rijbanen en voetgangerszones, wit voor opslagvakken en rood voor verbodszones of nooduitgangen. Parma Belijning Nederland adviseert over de juiste kleurcodering.' },
            { q: 'Kunnen jullie ook op weekenden werken?', a: "Ja. Om de bedrijfscontinuïteit te waarborgen, plannen we de werkzaamheden bij voorkeur buiten uw reguliere operationele uren — ook in weekenden of 's nachts." },
          ].map(faq => (
            <details class="group bg-white border border-slate-200 rounded-2xl overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none font-semibold text-slate-900 hover:bg-slate-50 transition-colors">
                {faq.q}
                <svg class="w-5 h-5 text-slate-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="px-6 pb-5 text-slate-600 text-sm leading-relaxed border-t border-slate-100 pt-4">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-brand-500">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl md:text-3xl font-black text-white mb-4">Magazijn- of logistieke belijning nodig?</h2>
        <p class="text-brand-100 mb-8">Parma Belijning Nederland adviseert u graag en maakt een vrijblijvende offerte op maat.</p>
        <a href="/offerte/?dienst=magazijn-logistieke-belijning" class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-brand-600 font-bold px-7 py-4 rounded-xl shadow-lg transition-colors">
          Vraag een offerte aan
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
