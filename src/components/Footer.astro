---
const diensten = [
  { label: 'Magazijn / Logistieke belijning', href: '/soorten-belijning/magazijn-logistieke-belijning/' },
  { label: 'Industriële belijning', href: '/soorten-belijning/industriele-belijning/' },
  { label: 'Parkeer belijning', href: '/soorten-belijning/parkeer-belijning/' },
  { label: 'Belijning binnen / buiten', href: '/diensten/belijning-binnen-buiten/' },
  { label: 'Kogelstralen', href: '/diensten/kogelstralen/' },
  { label: 'Vloercoating', href: '/diensten/vloercoating/' },
  { label: 'Pictogrammen / Symbolen', href: '/diensten/pictogrammen-symbolen/' },
  { label: 'Advies belijning', href: '/diensten/advies-belijning/' },
];

const steden = [
  'Amsterdam', 'Haarlem', 'Rotterdam', 'Den Haag', 'Utrecht',
  'Leiden', 'Alkmaar', 'Zaandam', 'Amstelveen', 'Hoofddorp',
];
---

<footer class="bg-slate-900 text-slate-300">
  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex flex-col gap-0.5">
            <span class="block w-8 h-1.5 bg-brand-500 rounded-full"></span>
            <span class="block w-6 h-1.5 bg-white rounded-full"></span>
            <span class="block w-8 h-1.5 bg-brand-500 rounded-full"></span>
          </div>
          <div>
            <span class="font-black text-xl text-white tracking-tight leading-none block">PARMA</span>
            <span class="font-semibold text-xs text-brand-400 tracking-widest uppercase leading-none block">Belijning Nederland</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed mb-6">
          Belijning-Nederland B.V. — uw betrouwbare partner voor alle soorten grondmarkeringen en belijning in Nederland.
        </p>
        <div class="space-y-2 text-sm">
          <p class="text-slate-400">IJweg 616, 2141 CN Vijfhuizen</p>
          <a href="tel:0235650840" class="flex items-center gap-2 text-slate-300 hover:text-brand-400 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" /></svg>
            023 565 08 40
          </a>
          <a href="mailto:info@parma-belijning.nl" class="flex items-center gap-2 text-slate-300 hover:text-brand-400 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            info@parma-belijning.nl
          </a>
        </div>
      </div>

      <!-- Diensten -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Diensten</h3>
        <ul class="space-y-2">
          {diensten.map(d => (
            <li>
              <a href={d.href} class="text-sm text-slate-400 hover:text-brand-400 transition-colors">
                {d.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Snel naar -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Snel naar</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-sm text-slate-400 hover:text-brand-400 transition-colors">Home</a></li>
          <li><a href="/fotos/" class="text-sm text-slate-400 hover:text-brand-400 transition-colors">Foto's & Projecten</a></li>
          <li><a href="/contact/" class="text-sm text-slate-400 hover:text-brand-400 transition-colors">Contact / FAQ</a></li>
          <li><a href="/offerte/" class="text-sm text-slate-400 hover:text-brand-400 transition-colors">Offerte aanvragen</a></li>
        </ul>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mt-6 mb-4">Actief in</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          {steden.join(' · ')} · en heel Nederland
        </p>
      </div>

      <!-- CTA -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Direct contact</h3>
        <p class="text-sm text-slate-400 mb-5 leading-relaxed">
          Betrouwbaar · Topkwaliteit · Flexibel. Vraag vrijblijvend een offerte aan.
        </p>
        <a
          href="/offerte/"
          class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-400 text-white text-sm font-semibold px-5 py-3 rounded-lg transition-colors w-full justify-center"
        >
          Vraag een offerte aan
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
        <a
          href="tel:0235650840"
          class="inline-flex items-center gap-2 border border-slate-600 hover:border-slate-400 text-slate-300 hover:text-white text-sm font-medium px-5 py-3 rounded-lg transition-colors w-full justify-center mt-3"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z" /></svg>
          023 565 08 40
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500">
        &copy; {new Date().getFullYear()} Belijning-Nederland B.V. — Alle rechten voorbehouden.
      </p>
      <div class="flex items-center gap-4 text-xs text-slate-500">
        <a href="/disclaimer/" class="hover:text-slate-300 transition-colors">Disclaimer</a>
        <a href="/algemene-voorwaarden/" class="hover:text-slate-300 transition-colors">Algemene voorwaarden</a>
      </div>
    </div>
  </div>
</footer>
